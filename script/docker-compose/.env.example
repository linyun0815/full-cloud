# 复制为 .env 后修改：cp .env.example .env
# 以下密码仅为示例，部署前请替换；.env 已被 .gitignore 忽略，不要提交

## 应用容器接入的已有中间件网络（Nacos/MySQL/Redis 所在网络）
SHARED_NETWORK=baota_net

## 宿主机 Nginx 反向代理网关的端口（只绑定 127.0.0.1）
GATEWAY_PORT=48080

## 后端镜像 tag（每次重新打包后可修改，便于回滚）
IMAGE_TAG=local

## MySQL（复用服务器已有实例，需预先建库并导入 SQL）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_USER=yudao
MYSQL_PASSWORD=Yudao@ChangeMe2026

## Redis（复用服务器已有实例）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=Redis@ChangeMe2026

## 后端应用
SPRING_PROFILES_ACTIVE=dev
# 需与前端打包时的 VITE_APP_CAPTCHA_ENABLE 一致
FULL_CAPTCHA_ENABLE=true

## JVM 与容器内存
# 默认值已按 2G 可用内存的服务器收紧，内存充足时再按需调大；调优说明见 README.md
# 旧版统一的 JAVA_OPTS 已不再使用，配置了也会被忽略
# 网关：堆 128~256m，容器上限 512m
# GATEWAY_JAVA_OPTS=-Xms128m -Xmx256m -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=96m -Xss512k -XX:ActiveProcessorCount=2 -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError
# GATEWAY_MEM_LIMIT=512m
# 业务服务（system-server / infra-server）：堆 192~320m，容器上限 640m
# APP_JAVA_OPTS=-Xms192m -Xmx320m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m -XX:MaxDirectMemorySize=96m -Xss512k -XX:ActiveProcessorCount=2 -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError
# APP_MEM_LIMIT=640m

## Nacos（复用服务器已有实例，已开启鉴权）
NACOS_SERVER_ADDR=nacos:8848
# 命名空间 ID（不是名称），需已存在
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=
NACOS_PASSWORD=
